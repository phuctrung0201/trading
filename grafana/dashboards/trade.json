{
  "uid": "trade-dashboard",
  "title": "Trade Dashboard",
  "tags": ["trading"],
  "timezone": "utc",
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "session_id",
        "type": "query",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "query": {
          "queryType": "sql",
          "rawSql": "SELECT DISTINCT session_id FROM trading.trade_event ORDER BY session_id DESC"
        },
        "sort": 0,
        "multi": true,
        "includeAll": false,
        "label": "Session",
        "current": {},
        "refresh": 1,
        "definition": "SELECT DISTINCT session_id FROM trading.trade_event ORDER BY session_id DESC"
      },
      {
        "name": "setup",
        "type": "query",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "query": {
          "queryType": "sql",
          "rawSql": "SELECT DISTINCT setup FROM trading.trade_event ORDER BY setup DESC"
        },
        "sort": 0,
        "multi": true,
        "includeAll": false,
        "label": "Setup",
        "current": {},
        "refresh": 1,
        "definition": "SELECT DISTINCT setup FROM trading.trade_event ORDER BY setup DESC"
      },
      {
        "name": "funding_session",
        "type": "query",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "query": {
          "queryType": "sql",
          "rawSql": "SELECT session_id FROM trading.funding_session FINAL WHERE status != 'RUNNING' ORDER BY timestamp DESC"
        },
        "sort": 0,
        "multi": true,
        "includeAll": false,
        "label": "Funding Session",
        "current": {},
        "refresh": 1,
        "definition": "SELECT session_id FROM trading.funding_session FINAL WHERE status != 'RUNNING' ORDER BY timestamp DESC"
      },
      {
        "name": "pair",
        "type": "query",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
        "query": {
          "queryType": "sql",
          "rawSql": "SELECT DISTINCT pair FROM trading.funding_monitor ORDER BY pair"
        },
        "sort": 0,
        "multi": true,
        "includeAll": true,
        "label": "Pair",
        "current": {},
        "refresh": 1,
        "definition": "SELECT DISTINCT pair FROM trading.funding_monitor ORDER BY pair"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Final Equity",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT equity FROM trading.trade_event WHERE event IS NULL AND session_id IN ($session_id) AND setup IN ($setup) ORDER BY timestamp DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      }
    },
    {
      "id": 2,
      "title": "Total Return %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT ((last_eq - first_eq) / first_eq) * 100 AS return_pct FROM (SELECT argMin(equity, timestamp) AS first_eq, argMax(equity, timestamp) AS last_eq FROM trading.trade_event WHERE event IS NULL AND session_id IN ($session_id) AND setup IN ($setup))",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0 }, { "color": "green", "value": 10 }] } }
      }
    },
    {
      "id": 3,
      "title": "Max Drawdown",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT min(drawdown) * 100 AS max_dd FROM trading.trade_event WHERE event IS NULL AND session_id IN ($session_id) AND setup IN ($setup)",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": -20 }, { "color": "green", "value": -10 }] } }
      }
    },
    {
      "id": 4,
      "title": "Sharpe Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT sharpe_ratio FROM trading.trade_event WHERE event IS NULL AND session_id IN ($session_id) AND setup IN ($setup) ORDER BY timestamp DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 3, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 1.0 }] } }
      }
    },
    {
      "id": 5,
      "title": "Trade Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT count() AS trades FROM trading.trade_event WHERE event IN ('open', 'close') AND session_id IN ($session_id) AND setup IN ($setup)",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      }
    },
    {
      "id": 16,
      "title": "PnL",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT sum(pnl) AS total_pnl FROM trading.trade_event WHERE event = 'close' AND pnl IS NOT NULL AND session_id IN ($session_id) AND setup IN ($setup)",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0 }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 10,
      "title": "Equity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, argMax(equity, timestamp) AS equity FROM trading.trade_event WHERE event IS NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2, "custom": { "fillOpacity": 15, "lineWidth": 1 } }
      }
    },
    {
      "id": 11,
      "title": "Drawdown",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, min(drawdown) * 100 AS drawdown FROM trading.trade_event WHERE event IS NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "fillOpacity": 20, "lineWidth": 1 } }
      }
    },
    {
      "id": 14,
      "title": "Sharpe Ratio",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, argMax(sharpe_ratio, timestamp) AS sharpe FROM trading.trade_event WHERE event IS NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 3, "custom": { "lineWidth": 1 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 1.0 }] } }
      }
    },
    {
      "id": 15,
      "title": "Z-Score",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, argMax(zscore, timestamp) AS z FROM trading.trade_event WHERE event IS NULL AND zscore IS NOT NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": -0.5 }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] }
        }
      }
    },
    {
      "id": 12,
      "title": "MA Indicators",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, concat(ifNull(indicator, 'ema'), ':short:', session_id) AS series, argMax(short_ema, timestamp) AS value FROM trading.trade_event WHERE event IS NULL AND short_ema IS NOT NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, series ORDER BY t",
          "refId": "A",
          "format": 0
        },
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, concat(ifNull(indicator, 'ema'), ':long:', session_id) AS series, argMax(long_ema, timestamp) AS value FROM trading.trade_event WHERE event IS NULL AND long_ema IS NOT NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, series ORDER BY t",
          "refId": "B",
          "format": 0
        },
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, concat('price:', session_id) AS series, argMax(close_price, timestamp) AS value FROM trading.trade_event WHERE event IS NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, series ORDER BY t",
          "refId": "C",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": ".+ (.+)", "renamePattern": "$1" } }
      ]
    },
    {
      "id": 13,
      "title": "Position",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, argMax(position_size, timestamp) AS position FROM trading.trade_event WHERE event IS NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "gradientMode": "scheme" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 17,
      "title": "Trade Event Log",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT timestamp, event, signal, position_side, position_size, fill_price, pnl, equity, drawdown * 100 AS drawdown_pct, exposure_ratio, reason FROM trading.trade_event WHERE event IS NOT NULL AND session_id IN ($session_id) AND setup IN ($setup) ORDER BY timestamp DESC LIMIT 200",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "pnl" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "equity" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "drawdown_pct" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "decimals", "value": 2 }] }
        ]
      }
    },
    {
      "id": 21,
      "title": "API Latency",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 44 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, avg(api_latency_ms) AS latency FROM trading.ops WHERE type = 'api' AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 22,
      "title": "API Response Log",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 44 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT timestamp, response_code, response_source, api_latency_ms FROM trading.ops WHERE type = 'api' AND session_id IN ($session_id) AND setup IN ($setup) ORDER BY timestamp DESC LIMIT 100",
          "refId": "A",
          "format": 1
        }
      ]
    },
    {
      "id": 25,
      "title": "Candle Lag",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, avg(candle_lag_ms) AS lag FROM trading.ops WHERE type = 'tick' AND candle_lag_ms IS NOT NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 1 } }
      }
    },
    {
      "id": 26,
      "title": "Write Buffer Size",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "interval": "1m",
      "targets": [
        {
          "rawSql": "SELECT toStartOfInterval(timestamp, INTERVAL $__interval_ms millisecond) AS t, session_id, max(write_buffer_size) AS buf_size FROM trading.ops WHERE type = 'tick' AND write_buffer_size IS NOT NULL AND timestamp >= $__fromTime AND timestamp <= $__toTime AND session_id IN ($session_id) AND setup IN ($setup) GROUP BY t, session_id ORDER BY t",
          "refId": "A",
          "format": 0
        }
      ],
      "transformations": [
        { "id": "renameByRegex", "options": { "regex": "(.+) (.+)", "renamePattern": "$2" } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10 } }
      }
    },
    {
      "id": 23,
      "title": "Reconciliation Log",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT timestamp, reconcile_equity_diff, reconcile_position_match, reconcile_correction FROM trading.ops WHERE type = 'reconcile' AND session_id IN ($session_id) AND setup IN ($setup) ORDER BY timestamp DESC LIMIT 100",
          "refId": "A",
          "format": 1
        }
      ]
    },
    {
      "id": 24,
      "title": "Error Log",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT timestamp, error_message FROM trading.ops WHERE type = 'error' AND session_id IN ($session_id) AND setup IN ($setup) ORDER BY timestamp DESC LIMIT 100",
          "refId": "A",
          "format": 1
        }
      ]
    },

    {
      "id": 100,
      "title": "Funding Capture",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 62 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "title": "Funding Session Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 63 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT status FROM trading.funding_session FINAL WHERE session_id IN ($funding_session) AND status != 'RUNNING' ORDER BY timestamp DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "SUCCESS": { "color": "green", "text": "SUCCESS" },
                "FAILED": { "color": "red", "text": "FAILED" }
              }
            }
          ],
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 102,
      "title": "Candidates",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 63 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT count() FROM trading.funding_screen WHERE session_id IN ($funding_session)",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } }
      }
    },
    {
      "id": 103,
      "title": "Active Positions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 63 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT count(DISTINCT pair) FROM trading.funding_monitor WHERE timestamp >= now() - INTERVAL 1 DAY",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }] } }
      }
    },
    {
      "id": 104,
      "title": "Avg Funding Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 63 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT round(avg(funding_rate) * 100, 4) FROM trading.funding_screen WHERE session_id IN ($funding_session)",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4,
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.005 }] }
        }
      }
    },
    {
      "id": 110,
      "title": "Screening Results",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 67 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "targets": [
        {
          "rawSql": "SELECT pair, inst_id, direction, funding_rate, timestamp FROM trading.funding_screen WHERE session_id IN ($funding_session) ORDER BY abs(funding_rate) DESC",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "funding_rate" }, "properties": [{ "id": "decimals", "value": 6 }] },
          {
            "matcher": { "id": "byName", "options": "direction" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
